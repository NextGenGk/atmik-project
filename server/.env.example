# ---- App ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- MongoDB (Atlas) ----
# Get from Atlas → Database → Connect → Drivers → connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/atmik_inventory?retryWrites=true&w=majority

# ---- Clerk (backend verification) — OPTIONAL ----
# Leave empty to run in demo mode (auth middleware disabled).
CLERK_SECRET_KEY=

# ---- Security headers (production only) ----
HELMET_ENABLED=false
